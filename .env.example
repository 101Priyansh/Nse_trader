# Copy this file to .env and fill in real values:  cp .env.example .env

# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Main Telegram bot — token from @BotFather (/mybots -> API Token)
TELE_TOKEN=123456789:your_telegram_bot_token_here
TELE_CHAT_ID=your_chat_id_here

# Optional second recipient (leave blank to disable)
TELE_TOKEN_SID=123456789:your_second_bot_token_here
TELE_CHAT_ID_SID=your_second_chat_id_here
